# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.

# MongoDB connection string (Atlas or local), including the database name, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rewear?retryWrites=true&w=majority
#   mongodb://127.0.0.1:27017/rewear
 MONGODB_URI=mongodb://rifatchowdhurysabuj786_db_user:rewear@ac-mcwicjb-shard-00-00.ci59qkz.mongodb.net:27017,ac-mcwicjb-shard-00-01.ci59qkz.mongodb.net:27017,ac-mcwicjb-shard-00-02.ci59qkz.mongodb.net:27017/rewear?ssl=true&replicaSet=atlas-x3crnd-shard-0&authSource=admin&appName=Cluster0

# Long random string used to sign session cookies (at least 32 characters).
# Generate one in PowerShell with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=ia7MQRm2R0O3RNusj_IAUnL1FyglwslbUCfAEM2-ByPrzUs7yKFPs_SWmAMtjKuJ

# Email address of the one account allowed to open /admin.
# Register (or seed) an account with this exact email address.
ADMIN_EMAIL=

# OPTIONAL, local demos only: set to true to show one-click "demo account" buttons on the login page
# (needs `npm run seed`). Leave empty on a real deployment.
DEMO_LOGIN=true
