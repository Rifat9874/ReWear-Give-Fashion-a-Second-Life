{
  "name": "rewear",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ReWear - a pre-loved fashion discovery marketplace (Next.js + MongoDB)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
